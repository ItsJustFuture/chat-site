{
  "name": "chat-site",
  "version": "1.0.0",
  "description": "",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "LOCAL_DEV=1 node server.js",
    "dev:seed": "LOCAL_DEV=1 node scripts/dev-seed.js",
    "test": "jest tests/ --passWithNoTests && npm run test:smoke",
    "test:unit": "jest tests/ --passWithNoTests",
    "test:dice": "node scripts/dice-variant-smoke.js",
    "test:couples": "node scripts/couples-regression.js",
    "test:chess": "node scripts/chess-elo-smoke.js",
    "test:smoke": "LOCAL_DEV=1 node scripts/smoke-test.js",
    "test:memory": "node scripts/memory-sanity.js",
    "check": "node --check server.js && node --check public/app.js && node --check public/theme-init.js && node --check database.js",
    "audit": "npm audit --audit-level=high",
    "fund": "npm fund",
    "verify": "(npm run fund --if-present || true) && npm run check && npm run audit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@sentry/node": "^8.45.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcrypt": "^6.0.0",
    "chess.js": "^1.0.0",
    "connect-pg-simple": "^10.0.0",
    "dompurify": "^3.2.3",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "isomorphic-dompurify": "^2.19.0",
    "jsdom": "^25.0.1",
    "marked": "^15.0.6",
    "multer": "^2.0.2",
    "nodemailer": "^6.10.1",
    "pg": "^8.16.3",
    "redis": "^4.7.0",
    "socket.io": "^4.8.3",
    "sqlite3": "^5.1.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.2.2"
  },
  "overrides": {
    "qs": "^6.14.1"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/tests/**/*.test.js"],
    "collectCoverageFrom": ["*.js", "!tests/**", "!scripts/**", "!node_modules/**"],
    "coveragePathIgnorePatterns": ["/node_modules/", "/tests/", "/scripts/"]
  }
}
